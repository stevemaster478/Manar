# Environment Variables Example for Manār (منار)
# Copy this file to .env and fill in your actual values

# ============================================
# Database (Neon PostgreSQL - free tier)
# ============================================
# Get your free database at: https://neon.tech
# After creating the project, copy the Connection String
DATABASE_URL=postgresql://user:password@host/database

# ============================================
# Authentication - Google OAuth
# ============================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# For development, use: http://localhost:5173/api/auth/google/callback
# For production, use: https://yourdomain.vercel.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# ============================================
# Authentication - Apple Sign-In (Optional)
# ============================================
# Create service ID at: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=your_apple_service_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key
# For development: http://localhost:5173/api/auth/apple/callback
# For production: https://yourdomain.vercel.app/api/auth/apple/callback
APPLE_REDIRECT_URI=http://localhost:5173/api/auth/apple/callback

# ============================================
# Google Gemini API
# ============================================
# Get API key at: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# ============================================
# Shamela.ws Web Scraping (Optional)
# ============================================
# ⚠️ IMPORTANTE LEGALE:
# - Lo scraping potrebbe violare i termini di servizio di Shamela.ws
# - Usa solo per uso personale/educativo
# - Rispetta rate limiting (max 10 richieste/minuto implementato)
# - Verifica i ToS prima di abilitare
# 
# Per abilitare lo scraping, imposta:
ENABLE_SHAMELA_SCRAPING=false
# Cambia a "true" solo dopo aver verificato i termini di servizio

# ============================================
# Session Secret
# ============================================
# Generate a random secret key (minimum 32 characters)
# You can generate one with: openssl rand -base64 32
SESSION_SECRET=your-random-secret-key-change-in-production-min-32-chars

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

